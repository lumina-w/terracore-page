{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .claude/CHECKPOINT.md 2>/dev/null || echo 'Sin checkpoint aún.'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Recuerda correr /checkpoint antes de compactar.' >&2"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Recuerda correr /checkpoint antes de cerrar sesión.' >&2"
          }
        ]
      }
    ]
  }
}
